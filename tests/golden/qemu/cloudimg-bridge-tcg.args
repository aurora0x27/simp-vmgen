qemu-system-x86_64 -name golden -machine q35,accel=tcg -cpu max -smp 4 -m 4G -rtc base=utc -drive if=virtio,file=/project/.simp-vmgen/run/overlay.qcow2,format=qcow2 -drive if=virtio,file=/project/.simp-vmgen/run/seed.iso,format=raw,readonly=on -netdev user,id=n0,hostfwd=tcp:127.0.0.1:2222-:22 -device virtio-net-pci,netdev=n0,mac=02:84:34:43:ca:b8 -netdev bridge,id=net1,br=br0 -device virtio-net-pci,netdev=net1,mac=02:0d:f5:69:c1:bd -device virtio-rng-pci -display none -monitor unix:/project/.simp-vmgen/run/monitor.sock,server=on,wait=off -chardev socket,id=ser0,path=/project/.simp-vmgen/run/serial.sock,server=on,wait=off,logfile=/project/.simp-vmgen/run/serial.log,logappend=on -serial chardev:ser0 -pidfile /project/.simp-vmgen/run/qemu.pid -D /project/.simp-vmgen/run/qemu.log -virtfs local,path=/host/work,mount_tag=host0,security_model=none,id=host0 -daemonize
