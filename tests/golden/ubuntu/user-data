#cloud-config
# Generated by simp-vmgen 0.2.0. Do not edit the seed by hand.
hostname: "golden-ubuntu"
fqdn: "golden-ubuntu.local"
manage_etc_hosts: true
timezone: "Asia/Shanghai"

users:
  - name: "root"
    lock_passwd: false
    shell: "/usr/bin/fish"
  - name: "alice"
    lock_passwd: false
    shell: "/usr/bin/bash"
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    groups: ["docker"]
    ssh_authorized_keys:
      - "ssh-ed25519 AAAA alice"
      - "ssh-ed25519 AAAA generated"

chpasswd:
  expire: false
  users:
    - name: "root"
      password: "root-secret"
      type: text
    - name: "alice"
      password: "alice-secret"
      type: text

ssh_pwauth: true
disable_root: false
package_update: true
package_upgrade: false
packages:
  - "ca-certificates"
  - "curl"
  - "file"
  - "fish"
  - "git"
  - "iproute2"
  - "kmod"
  - "less"
  - "procps"
  - "python3"
  - "util-linux"
  - "vim"
  - "binutils"
  - "build-essential"
  - "clang"
  - "elfutils"
  - "gcc"
  - "gdb"
  - "jq"
  - "libelf-dev"
  - "ltrace"
  - "make"
  - "man-db"
  - "pkg-config"
  - "strace"
  - "tree"
  - "zsh"

write_files:
  - path: /etc/ssh/sshd_config.d/01-simp-vmgen.conf
    permissions: "0644"
    content: |
      PermitRootLogin yes
      PasswordAuthentication yes
  - path: /usr/local/sbin/simp-vmgen-mounts
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      modprobe 9p 2>/dev/null || true
      modprobe 9pnet_virtio 2>/dev/null || true
      mkdir -p /work
      if ! grep -q 'host0 /work' /etc/fstab; then
          printf '%s\n' 'host0 /work 9p trans=virtio,version=9p2000.L,rw,nofail 0 0' >> /etc/fstab
      fi
      mountpoint -q /work || mount -t 9p -o trans=virtio,version=9p2000.L host0 /work || true
      mkdir -p /src
      if ! grep -q 'host1 /src' /etc/fstab; then
          printf '%s\n' 'host1 /src 9p trans=virtio,version=9p2000.L,ro,nofail 0 0' >> /etc/fstab
      fi
      mountpoint -q /src || mount -t 9p -o trans=virtio,version=9p2000.L,ro host1 /src || true
  - path: /usr/local/sbin/simp-vmgen-ready
    permissions: "0755"
    content: |
      #!/bin/sh
      echo "SIMP_VMGEN_READY name=golden-ubuntu host=$(hostname) kernel=$(uname -r) ssh=alice root=yes" > /dev/console
  - path: /etc/systemd/system/simp-vmgen-ready.service
    content: |
      [Unit]
      Description=simp-vmgen readiness marker
      After=multi-user.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/simp-vmgen-ready
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target

bootcmd:
  - [ sh, -c, "sed -i -E 's/^Components:.*/Components: main restricted universe multiverse/' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true" ]

runcmd:
  - systemctl daemon-reload
  - bash -c 'id ubuntu >/dev/null 2>&1 && userdel -r ubuntu || true'
  - systemctl enable --now ssh || true
  - systemctl restart ssh || true
  - systemctl enable --now serial-getty@ttyS0.service || true
  - /usr/local/sbin/simp-vmgen-mounts || true
  - systemctl enable --now simp-vmgen-ready.service || true
  - systemctl restart simp-vmgen-ready.service || true

final_message: "simp-vmgen guest ready after $UPTIME s"
