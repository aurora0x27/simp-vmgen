#cloud-config
# Generated by simp-vmgen 0.1.0. Do not edit the seed by hand.
hostname: "golden-alpine"
fqdn: "golden-alpine.local"
manage_etc_hosts: true
timezone: "Asia/Shanghai"

users:
  - name: "root"
    lock_passwd: false
    shell: "/bin/sh"
  - name: "alice"
    lock_passwd: false
    shell: "/bin/bash"
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    groups: ["docker"]
    ssh_authorized_keys:
      - "ssh-ed25519 AAAA alice"
      - "ssh-ed25519 AAAA generated"

chpasswd:
  expire: false
  users:
    - name: "root"
      password: "root-secret"
      type: text
    - name: "alice"
      password: "alice-secret"
      type: text

ssh_pwauth: true
disable_root: false

write_files:
  - path: /usr/local/sbin/simp-vmgen-mounts
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      modprobe 9p 2>/dev/null || true
      modprobe 9pnet_virtio 2>/dev/null || true
      mkdir -p /work
      if ! grep -q 'host0 /work' /etc/fstab; then
          printf '%s\n' 'host0 /work 9p trans=virtio,version=9p2000.L,rw,nofail 0 0' >> /etc/fstab
      fi
      mountpoint -q /work || mount -t 9p -o trans=virtio,version=9p2000.L host0 /work || true
      mkdir -p /src
      if ! grep -q 'host1 /src' /etc/fstab; then
          printf '%s\n' 'host1 /src 9p trans=virtio,version=9p2000.L,ro,nofail 0 0' >> /etc/fstab
      fi
      mountpoint -q /src || mount -t 9p -o trans=virtio,version=9p2000.L,ro host1 /src || true
  - path: /usr/local/sbin/simp-vmgen-ssh
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      conf=/etc/ssh/sshd_config
      touch "$conf"
      if grep -q '^PermitRootLogin' "$conf"; then
          sed -i -E 's/^PermitRootLogin.*/PermitRootLogin yes/' "$conf"
      else
          echo 'PermitRootLogin yes' >> "$conf"
      fi
      if grep -q '^PasswordAuthentication' "$conf"; then
          sed -i -E 's/^PasswordAuthentication.*/PasswordAuthentication yes/' "$conf"
      else
          echo 'PasswordAuthentication yes' >> "$conf"
      fi
  - path: /usr/local/bin/simp-vmgen-ready
    permissions: "0755"
    content: |
      #!/bin/sh
      echo "SIMP_VMGEN_READY name=golden-alpine host=$(hostname) kernel=$(uname -r) ssh=alice root=yes" > /dev/console
  - path: /etc/init.d/simp-vmgen-ready
    permissions: "0755"
    content: |
      #!/sbin/openrc-run
      description="simp-vmgen readiness marker"
      command="/usr/local/bin/simp-vmgen-ready"
      command_background="no"

runcmd:
  - sh -c 'apk update'
  - sh -c 'for i in 1 2 3; do apk add bash ca-certificates curl file fish git iproute2 less openssh procps python3 sudo tzdata util-linux vim binutils build-base elfutils-dev gdb jq linux-headers ltrace make mandoc pkgconf strace tree zsh && exit 0; sleep 2; done; exit 1'
  - /usr/local/sbin/simp-vmgen-ssh
  - rc-update add sshd default || true
  - rc-service sshd restart || true
  - sh -c 'grep -q "^ttyS0" /etc/inittab 2>/dev/null || echo "ttyS0::respawn:/sbin/getty -L ttyS0 115200 vt100" >> /etc/inittab; kill -HUP 1 || true'
  - /usr/local/sbin/simp-vmgen-mounts || true
  - rc-update add simp-vmgen-ready default || true
  - rc-service simp-vmgen-ready restart || true
  - /usr/local/bin/simp-vmgen-ready || true
  - sh -c 'id alpine >/dev/null 2>&1 && deluser --remove-home alpine || true'

final_message: "simp-vmgen guest ready after $UPTIME s"
