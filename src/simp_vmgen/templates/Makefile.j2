# Generated by simp-vmgen {{ tool_version }} from vmgen.toml.
# Do not edit this file by hand: edit vmgen.toml and run `make regen`.
SIMP_VMGEN ?= simp-vmgen
.DEFAULT_GOAL := help

.PHONY: help build regen regen-check show diagnose up restart run run-fg snapshot stop status wait log \
        log-follow tty ssh serial console guest lab kernel-fetch kernel-config \
        kernel-build kernel-rootfs kernel-initramfs kernel-status kernel-clean clean distclean

help:
	@echo "{{ config.project.name }} targets:"
	@echo "  build/up/restart/run/wait/status/log/stop/clean"
	@echo "  guest CMD='...' / lab CMD='...'"
	@echo "  regen/regen-check/show/diagnose"
{% if config.kernel.enabled %}
	@echo "  kernel-fetch/kernel-config/kernel-build/kernel-rootfs/kernel-initramfs/kernel-status/kernel-clean"
{% endif %}

build:
	@$(SIMP_VMGEN) build

up:
	@$(SIMP_VMGEN) up

restart:
	@$(SIMP_VMGEN) restart

regen:
	@$(SIMP_VMGEN) regen

regen-check:
	@$(SIMP_VMGEN) regen --check

show:
	@$(SIMP_VMGEN) show

diagnose:
	@$(SIMP_VMGEN) diagnose

run:
	@$(SIMP_VMGEN) run

run-fg:
	@$(SIMP_VMGEN) run --foreground

snapshot:
	@$(SIMP_VMGEN) run --snapshot

stop:
	@$(SIMP_VMGEN) stop

status:
	@$(SIMP_VMGEN) status

wait:
	@$(SIMP_VMGEN) wait

log:
	@$(SIMP_VMGEN) log

log-follow:
	@$(SIMP_VMGEN) log -f

tty:
	@$(SIMP_VMGEN) tty

ssh: tty

serial:
	@$(SIMP_VMGEN) serial

console:
	@$(SIMP_VMGEN) console

guest:
	@$(if $(strip $(CMD)),,$(error usage: make guest CMD="..."))
	@$(SIMP_VMGEN) guest -- "$$CMD"

lab:
	@$(if $(strip $(CMD)),,$(error usage: make lab CMD="..."))
	@$(SIMP_VMGEN) guest --workdir {{ work_target }} -- "$$CMD"

kernel-fetch:
	@$(SIMP_VMGEN) kernel fetch

kernel-config:
	@$(SIMP_VMGEN) kernel config

kernel-build:
	@$(SIMP_VMGEN) kernel build

kernel-initramfs:
	@$(SIMP_VMGEN) kernel initramfs

kernel-rootfs:
	@$(SIMP_VMGEN) kernel rootfs

kernel-status:
	@$(SIMP_VMGEN) kernel status

kernel-clean:
	@$(SIMP_VMGEN) kernel clean

clean:
	@$(SIMP_VMGEN) clean

distclean:
	@$(SIMP_VMGEN) clean --all
