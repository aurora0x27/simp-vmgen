#cloud-config
# Generated by simp-vmgen 0.3.2. Do not edit the seed by hand.
hostname: "golden-openeuler"
fqdn: "golden-openeuler.local"
manage_etc_hosts: false
timezone: "Asia/Shanghai"

users:
  - name: "root"
    lock_passwd: false
    shell: "/bin/bash"
    ssh_authorized_keys:
      - "ssh-ed25519 AAAA generated"

chpasswd:
  expire: false
  users:
    - name: "root"
      password: "114514"
      type: text

ssh_pwauth: true
disable_root: false
package_update: false
package_upgrade: false

write_files:
  - path: /usr/local/sbin/simp-vmgen-ssh
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      conf=/etc/ssh/sshd_config
      touch "$conf"
      if grep -q '^PermitRootLogin' "$conf"; then
          sed -i -E 's/^PermitRootLogin.*/PermitRootLogin yes/' "$conf"
      else
          echo 'PermitRootLogin yes' >> "$conf"
      fi
      if grep -q '^PasswordAuthentication' "$conf"; then
          sed -i -E 's/^PasswordAuthentication.*/PasswordAuthentication yes/' "$conf"
      else
          echo 'PasswordAuthentication yes' >> "$conf"
      fi
  - path: /usr/local/sbin/simp-vmgen-mounts
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      modprobe 9p 2>/dev/null || true
      modprobe 9pnet_virtio 2>/dev/null || true
      mkdir -p /work
      if ! grep -q 'host0 /work' /etc/fstab; then
          printf '%s\n' 'host0 /work 9p trans=virtio,version=9p2000.L,rw,nofail 0 0' >> /etc/fstab
      fi
      mountpoint -q /work || mount -t 9p -o trans=virtio,version=9p2000.L host0 /work || true
  - path: /usr/local/sbin/simp-vmgen-ready
    permissions: "0755"
    content: |
      #!/bin/sh
      echo "SIMP_VMGEN_READY name=golden-openeuler host=$(hostname) kernel=$(uname -r) ssh=root root=yes" > /dev/console
  - path: /etc/systemd/system/simp-vmgen-ready.service
    content: |
      [Unit]
      Description=simp-vmgen readiness marker
      After=multi-user.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/simp-vmgen-ready
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target

runcmd:
  - [ sh, -c, "/usr/local/sbin/simp-vmgen-ssh || true" ]
  - systemctl daemon-reload
  - systemctl enable --now sshd || true
  - systemctl restart sshd || true
  - systemctl enable --now serial-getty@ttyAMA0.service || true
  - [ sh, -c, "/usr/local/sbin/simp-vmgen-mounts || true" ]
  - systemctl enable --now simp-vmgen-ready.service || true
  - systemctl restart simp-vmgen-ready.service || true

final_message: "simp-vmgen guest ready after $UPTIME s"
