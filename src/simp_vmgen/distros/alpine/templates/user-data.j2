#cloud-config
# Generated by simp-vmgen {{ tool_version }}. Do not edit the seed by hand.
hostname: {{ hostname | tojson }}
fqdn: {{ fqdn | tojson }}
manage_etc_hosts: true
timezone: {{ timezone | tojson }}

users:
{% for user in users %}
  - name: {{ user.name | tojson }}
    lock_passwd: false
    shell: {{ user.shell | tojson }}
{% if user.sudo %}
    sudo: "ALL=(ALL) NOPASSWD:ALL"
{% endif %}
{% if user.groups %}
    groups: {{ user.groups | tojson }}
{% endif %}
{% if user.ssh_keys %}
    ssh_authorized_keys:
{% for key in user.ssh_keys %}
      - {{ key | tojson }}
{% endfor %}
{% endif %}
{% endfor %}

{% if ssh_pwauth %}
chpasswd:
  expire: false
  users:
{% for user in users if user.password %}
    - name: {{ user.name | tojson }}
      password: {{ user.password | tojson }}
      type: text
{% endfor %}
{% endif %}

ssh_pwauth: {{ "true" if ssh_pwauth else "false" }}
disable_root: false

write_files:
  - path: /usr/local/sbin/simp-vmgen-mounts
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      modprobe 9p 2>/dev/null || true
      modprobe 9pnet_virtio 2>/dev/null || true
{% for mount in mounts %}
      mkdir -p {{ mount.target | shquote }}
      if ! grep -q {{ (mount.tag ~ " " ~ mount.target) | shquote }} /etc/fstab; then
          printf '%s\n' {{ (mount.tag ~ " " ~ mount.target ~ " 9p trans=virtio,version=9p2000.L," ~ ("ro" if mount.readonly else "rw") ~ ",nofail 0 0") | shquote }} >> /etc/fstab
      fi
      mountpoint -q {{ mount.target | shquote }} || mount -t 9p -o trans=virtio,version=9p2000.L{{ ",ro" if mount.readonly else "" }} {{ mount.tag | shquote }} {{ mount.target | shquote }} || true
{% endfor %}
  - path: /usr/local/sbin/simp-vmgen-ssh
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      conf=/etc/ssh/sshd_config
      touch "$conf"
      if grep -q '^PermitRootLogin' "$conf"; then
          sed -i -E 's/^PermitRootLogin.*/PermitRootLogin {{ "yes" if root_login else "no" }}/' "$conf"
      else
          echo 'PermitRootLogin {{ "yes" if root_login else "no" }}' >> "$conf"
      fi
      if grep -q '^PasswordAuthentication' "$conf"; then
          sed -i -E 's/^PasswordAuthentication.*/PasswordAuthentication {{ "yes" if ssh_pwauth else "no" }}/' "$conf"
      else
          echo 'PasswordAuthentication {{ "yes" if ssh_pwauth else "no" }}' >> "$conf"
      fi
  - path: /usr/local/sbin/simp-vmgen-provision
    permissions: "0755"
    content: |
      #!/bin/sh
      set -u
{% if packages %}
      apk update || true
      for attempt in 1 2 3; do
          apk add {{ packages | map("shquote") | join(" ") }} && break
          sleep 2
      done
{% endif %}
      /usr/local/sbin/simp-vmgen-ssh || true
      rc-update add sshd default || true
      rc-service sshd restart || true
      grep -q '^ttyS0' /etc/inittab 2>/dev/null || echo 'ttyS0::respawn:/sbin/getty -L ttyS0 115200 vt100' >> /etc/inittab
      kill -HUP 1 || true
      /usr/local/sbin/simp-vmgen-mounts || true
      rc-update add simp-vmgen-ready default || true
      rc-service simp-vmgen-ready restart || true
      /usr/local/bin/simp-vmgen-ready || true
{% if users | selectattr("name", "equalto", "alpine") | list | length == 0 %}
      id alpine >/dev/null 2>&1 && deluser --remove-home alpine || true
{% endif %}
  - path: /usr/local/bin/simp-vmgen-ready
    permissions: "0755"
    content: |
      #!/bin/sh
      echo "{{ ready_marker }} host=$(hostname) kernel=$(uname -r) ssh={{ config.ssh.user }} root={{ "yes" if root_login else "no" }}" > /dev/console
  - path: /etc/init.d/simp-vmgen-ready
    permissions: "0755"
    content: |
      #!/sbin/openrc-run
      description="simp-vmgen readiness marker"
      command="/usr/local/bin/simp-vmgen-ready"
      command_background="no"

runcmd:
  # Keep cloud-final short: package installation can exceed the OpenRC
  # cloud-final service timeout, so run provisioning in a detached session.
  - sh -c 'setsid /usr/local/sbin/simp-vmgen-provision >/var/log/simp-vmgen-provision.log 2>&1 < /dev/null &'

final_message: "simp-vmgen provisioning started after $UPTIME s"
