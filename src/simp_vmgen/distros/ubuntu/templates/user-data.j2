#cloud-config
# Generated by simp-vmgen {{ tool_version }}. Do not edit the seed by hand.
hostname: {{ hostname | tojson }}
fqdn: {{ fqdn | tojson }}
manage_etc_hosts: true
timezone: {{ timezone | tojson }}

users:
{% for user in users %}
  - name: {{ user.name | tojson }}
    lock_passwd: false
    shell: {{ user.shell | tojson }}
{% if user.sudo %}
    sudo: "ALL=(ALL) NOPASSWD:ALL"
{% endif %}
{% if user.groups %}
    groups: {{ user.groups | tojson }}
{% endif %}
{% if user.ssh_keys %}
    ssh_authorized_keys:
{% for key in user.ssh_keys %}
      - {{ key | tojson }}
{% endfor %}
{% endif %}
{% endfor %}

{% if ssh_pwauth %}
chpasswd:
  expire: false
  users:
{% for user in users if user.password %}
    - name: {{ user.name | tojson }}
      password: {{ user.password | tojson }}
      type: text
{% endfor %}
{% endif %}

ssh_pwauth: {{ "true" if ssh_pwauth else "false" }}
disable_root: false
package_update: {{ "true" if packages else "false" }}
package_upgrade: false
packages:
{% for package in packages %}
  - {{ package | tojson }}
{% endfor %}

write_files:
  - path: /etc/ssh/sshd_config.d/01-simp-vmgen.conf
    permissions: "0644"
    content: |
      PermitRootLogin {{ "yes" if root_login else "no" }}
      PasswordAuthentication {{ "yes" if ssh_pwauth else "no" }}
  - path: /usr/local/sbin/simp-vmgen-mounts
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      modprobe 9p 2>/dev/null || true
      modprobe 9pnet_virtio 2>/dev/null || true
{% for mount in mounts %}
      mkdir -p {{ mount.target | shquote }}
      if ! grep -q {{ (mount.tag ~ " " ~ mount.target) | shquote }} /etc/fstab; then
          printf '%s\n' {{ (mount.tag ~ " " ~ mount.target ~ " 9p trans=virtio,version=9p2000.L," ~ ("ro" if mount.readonly else "rw") ~ ",nofail 0 0") | shquote }} >> /etc/fstab
      fi
      mountpoint -q {{ mount.target | shquote }} || mount -t 9p -o trans=virtio,version=9p2000.L{{ ",ro" if mount.readonly else "" }} {{ mount.tag | shquote }} {{ mount.target | shquote }} || true
{% endfor %}
  - path: /usr/local/sbin/simp-vmgen-ready
    permissions: "0755"
    content: |
      #!/bin/sh
      echo "{{ ready_marker }} host=$(hostname) kernel=$(uname -r) ssh={{ config.ssh.user }} root={{ "yes" if root_login else "no" }}" > /dev/console
  - path: /etc/systemd/system/simp-vmgen-ready.service
    content: |
      [Unit]
      Description=simp-vmgen readiness marker
      After=multi-user.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/simp-vmgen-ready
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target

bootcmd:
  - [ sh, -c, "sed -i -E 's/^Components:.*/Components: main restricted universe multiverse/' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true" ]

runcmd:
  - systemctl daemon-reload
  - bash -c 'id ubuntu >/dev/null 2>&1 && userdel -r ubuntu || true'
  - systemctl enable --now ssh || true
  - systemctl restart ssh || true
  - systemctl enable --now serial-getty@{{ console }}.service || true
  - /usr/local/sbin/simp-vmgen-mounts || true
  - systemctl enable --now simp-vmgen-ready.service || true
  - systemctl restart simp-vmgen-ready.service || true

final_message: "simp-vmgen guest ready after $UPTIME s"
